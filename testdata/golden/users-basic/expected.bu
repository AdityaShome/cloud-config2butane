variant: flatcar
version: 1.1.0
passwd:
  users:
    - name: alice
      gecos: Alice Example
      shell: /bin/bash
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI alice@example.com
      password_hash: "!$6$rounds=4096$saltsalt$hashhashhashhashhashhashhashhashhashhashhashhashha"
